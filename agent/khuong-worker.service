[Unit]
Description=Training Data Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/training-data-agent
EnvironmentFile=-%h/training-data-agent/agent/config.env
ExecStart=/usr/bin/python3 %h/training-data-agent/agent/agent.py
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
